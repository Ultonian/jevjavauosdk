<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.codefinch.jev</groupId>
    <artifactId>jev-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jev-examples</artifactId>
  <name>Jev Java Unofficial SDK - Examples</name>
  <description>Runnable examples. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Never part of the Central bundle, whatever profile is active. -->
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.source.skip>true</maven.source.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <!-- Used directly by tests and needed by the SDK when running the offline examples. -->
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>net.codefinch.jev</groupId>
      <artifactId>jev-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.codefinch.jev</groupId>
      <artifactId>jev-test</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Keep reactor Javadoc links consistent with the libraries' automatic module names. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>net.codefinch.jev.examples</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- ./mvnw -q -pl jev-examples exec:java -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>net.codefinch.jev.examples.AllExamples</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
